<?xml version="1.0" encoding="utf-8"?>
<!-- ✅ V8 — Android 12+ : interdit l'inclusion des données de l'app dans les
     sauvegardes cloud ET les transferts d'appareil à appareil. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="."/>
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="."/>
  </device-transfer>
</data-extraction-rules>
